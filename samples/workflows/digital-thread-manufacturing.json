{
  "name": "digital-thread-manufacturing",
  "description": "Complete digital thread pipeline: G-code parsing, CAM analysis, ISO 14649 conversion, scheduling",
  "version": "1.0",
  "stages": [
    {
      "name": "gcode_parsing",
      "agent": "gcode-parser",
      "description": "Parse G-code file and extract machining operations",
      "enabled": true,
      "config": {
        "export_blocks": true,
        "format": "json"
      }
    },
    {
      "name": "cam_analysis",
      "agent": "cam-runner",
      "description": "Analyze cutting paths using CAM runner",
      "enabled": true,
      "config": {
        "use_opencamlib": true,
        "use_dexel": false
      }
    },
    {
      "name": "digital_thread_conversion",
      "agent": "digital-thread-project-manager",
      "description": "Convert CAM data to ISO 14649 XML format",
      "enabled": true,
      "config": {
        "cam_path": null,
        "mapping_path": null,
        "output_path": null
      }
    },
    {
      "name": "tool_extraction",
      "agent": "digital-thread-project-manager",
      "description": "Extract ISO 13399 cutting tool definitions",
      "enabled": false,
      "config": {
        "cam_path": null,
        "mapping_path": null,
        "output_path": null
      }
    },
    {
      "name": "cell_scheduling",
      "agent": "cell-scheduler",
      "description": "Schedule manufacturing operations on cell machines",
      "enabled": true,
      "config": {
        "optimization_level": "high",
        "scheduling_horizon": "3d"
      }
    },
    {
      "name": "schedule_visualization",
      "agent": "cell-schedule-visualizer",
      "description": "Generate visualization of the schedule",
      "enabled": true,
      "config": {
        "format": "html",
        "include_gantt": true,
        "include_statistics": true
      }
    }
  ]
}
