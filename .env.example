# =============================================================================
# agents-workspace 환경변수 템플릿
# =============================================================================
# 사용법:
#   1. 이 파일을 .env.dev 또는 .env.prod로 복사
#   2. 환경에 맞게 값 수정
#   3. 서비스 시작 시 적절한 ENV_FILE 환경변수 설정
# =============================================================================

# -----------------------------------------------------------------------------
# 환경 설정
# -----------------------------------------------------------------------------
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 서비스 URL (서비스 간 통신)
# -----------------------------------------------------------------------------
CELL_MES_URL=http://localhost:8000
CELL_MES_HOST=0.0.0.0
CELL_MES_PORT=8000

NL_ROUTER_URL=http://localhost:8001
NL_ROUTER_HOST=0.0.0.0
NL_ROUTER_PORT=8001

CELL_SCHEDULER_URL=http://localhost:8002
CELL_SCHEDULER_HOST=0.0.0.0
CELL_SCHEDULER_PORT=8002

MIDDLEWARE_URL=http://localhost:8003
MIDDLEWARE_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis (이벤트 버스)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10
REDIS_DECODE_RESPONSES=true

# -----------------------------------------------------------------------------
# 데이터베이스
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/mes.db

# -----------------------------------------------------------------------------
# MES Interface DB (MES -> APS 읽기 전용 연동)
# -----------------------------------------------------------------------------
MES_INTERFACE_DB_PORT=15433
MES_INTERFACE_DB_NAME=mes_interface
MES_INTERFACE_DB_ADMIN_USER=if_owner
MES_INTERFACE_DB_ADMIN_PASSWORD=change-this-interface-db-admin-password
MES_INTERFACE_SYNC_USER=if_sync_writer
MES_INTERFACE_SYNC_PASSWORD=change-this-interface-sync-password
MES_INTERFACE_APS_READER_USER=aps_user
MES_INTERFACE_APS_READER_PASSWORD=change-this-aps-reader-password
MES_INTERFACE_SYNC_SCHEDULE=02:00,14:00
MES_INTERFACE_SYNC_TIMEZONE=Asia/Seoul
MES_INTERFACE_SYNC_RUN_ON_START=true
MES_INTERFACE_EXCLUDED_TABLES=users,middleware_config,alembic_version

# -----------------------------------------------------------------------------
# 인증/보안
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 내부 서비스 통신 키
INTERNAL_SERVICE_KEY=internal-service-key-change-in-production

# -----------------------------------------------------------------------------
# CORS 설정
# -----------------------------------------------------------------------------
# 쉼표로 구분된 허용 origin 목록
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 스케줄러 설정
# -----------------------------------------------------------------------------
SCHEDULER_DEFAULT_SOLVER=OR_TOOLS
SCHEDULER_DEFAULT_HORIZON_HOURS=24
SCHEDULER_DEFAULT_TIME_LIMIT_SEC=60
SCHEDULER_TIMEOUT=120

# -----------------------------------------------------------------------------
# 파일 업로드
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
SCENARIOS_DIR=./scenarios

# -----------------------------------------------------------------------------
# 폴링 설정
# -----------------------------------------------------------------------------
EQUIPMENT_POLL_INTERVAL_SEC=3

# -----------------------------------------------------------------------------
# LLM 설정 (NL-Router)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Digital Thread Project Manager (DTP) — VM / DP 외부 시스템 연동
# -----------------------------------------------------------------------------
# 실 운영에서는 VM/DP 본 시스템 정보로 교체. dev에서는 placeholder로 부팅만 가능.
# 민감 시크릿은 .env.dev/.env.prod 파일이 SynologyDrive에 평문 저장되므로
# 1Password 등 외부 시크릿 매니저에서 별도 관리 권장.
VM_API_URL=http://vm-mock.local
VM_USERNAME=dev
VM_PASSWORD=dev
DP_BASE_URL=http://dp-mock.local
DP_API_KEY=dev-placeholder

# DTP MongoDB (선택 — 미설정 시 graceful fallback)
MONGO_URI=mongodb://localhost:27017
DB_NAME=dt_dev

# -----------------------------------------------------------------------------
# Agent Orchestrator (LangGraph + LLM)
# -----------------------------------------------------------------------------
# LLM_PROVIDER 미설정 시 Mock provider 자동 fallback — 컨테이너 부팅 보장.
# 실 운영 시 anthropic | openai | ollama 중 하나 선택 + API key 설정.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_TEMPERATURE=0.1
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_ORCHESTRATOR_URL=http://localhost:8020
