# Copy to services.env when local ports or service URLs need overrides.

HOST=127.0.0.1
PORT_CELL_MES=8000
PORT_NL_ROUTER=8001
PORT_CELL_SCHEDULER=8002
PORT_FRONTEND=3000

ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key
INTERNAL_SERVICE_KEY=dev-internal-service-key

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CONTAINER_NAME=agents-workspace-redis
REDIS_IMAGE=redis:7-alpine

MIDDLEWARE_URL=http://localhost:8100
RELOAD=true

# Optional:
# STOP_REDIS=true ./stop-services.sh
