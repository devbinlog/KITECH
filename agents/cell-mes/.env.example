# Cell-MES Configuration

# Application
APP_NAME=Cell-MES
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cell_mes

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Middleware Server
MIDDLEWARE_BASE_URL=http://localhost:8001
MIDDLEWARE_TIMEOUT=30

# P4R Preview
P4R_FAILURE_RULES_PATH=./config/p4r_failure_rules.json

# Equipment Polling
EQUIPMENT_POLL_INTERVAL_SEC=3

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:3000"]
