{
  "name": "n8n-nodes-scenario",
  "version": "1.0.0",
  "description": "n8n custom nodes for AAS-based manufacturing scenario execution",
  "keywords": [
    "n8n-community-node-package"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/ScenarioConfig/ScenarioConfig.node.js",
      "dist/nodes/ScenarioStep/ScenarioStep.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0"
  }
}
