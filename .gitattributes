# Auto-detect text files
* text=auto

# Python — LF
*.py text eol=lf

# Shell — LF
*.sh text eol=lf

# PowerShell / Batch — CRLF (Windows native)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Web/JS — LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Config — LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
.env* text eol=lf

# Docs — LF
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Lockfiles — LF
uv.lock text eol=lf
package-lock.json text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pptx binary
*.docx binary
*.xlsx binary
*.step binary
*.tap binary
*.nc binary
